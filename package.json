{
  "name": "@fabrizio.manna/prismui",
  "version": "2.0.0",
  "private": true,
  "description": "PrismUI: an accessible, mobile-first glassmorphism web component framework built with Lit, Tailwind CSS and Vite.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./tokens.css": "./dist/tokens/prism-tokens.css",
    "./custom-elements.json": "./dist/custom-elements.json",
    "./package.json": "./package.json",
    "./*/class": {
      "types": "./dist/components/*/prism-*.d.ts",
      "default": "./dist/components/*/prism-*.js"
    },
    "./*": {
      "types": "./dist/components/*/define.d.ts",
      "default": "./dist/components/*/define.js"
    }
  },
  "sideEffects": [
    "./dist/index.js",
    "./dist/components/*/define.js",
    "./dist/core/global-styles.js",
    "*.css"
  ],
  "customElements": "dist/custom-elements.json",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:types && npm run analyze",
    "build:types": "node node_modules/typescript7/bin/tsc -p tsconfig.build.json",
    "analyze": "cem analyze --config custom-elements-manifest.config.mjs",
    "tokens:sync": "node scripts/sync-tokens.mjs && node scripts/generate-token-types.mjs",
    "tokens:types": "node scripts/generate-token-types.mjs",
    "lint": "eslint . && node scripts/lint-styles.mjs && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "typecheck": "node node_modules/typescript7/bin/tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --project browser",
    "test:storybook": "vitest run --project storybook",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "npm run analyze && storybook dev -p 6006",
    "build-storybook": "npm run analyze && storybook build",
    "check": "npm run lint && npm run typecheck && npm run build && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FabrizioManna/prismUI.git"
  },
  "keywords": [
    "ui",
    "components",
    "lit",
    "web-components",
    "glassmorphism",
    "tailwind",
    "prismui"
  ],
  "author": "Fabrizio Manna",
  "license": "ISC",
  "engines": {
    "node": ">=24.0.0"
  },
  "bugs": {
    "url": "https://github.com/FabrizioManna/prismUI/issues"
  },
  "homepage": "https://github.com/FabrizioManna/prismUI#readme",
  "peerDependencies": {
    "lit": "^3.3.3"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@lit/context": "^1.1.6",
    "lucide-static": "^1.78.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/addon-themes": "^10.6.8",
    "@storybook/addon-vitest": "^10.6.8",
    "@storybook/web-components-vite": "^10.6.8",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@vitest/browser": "^5.1.1",
    "@vitest/browser-playwright": "^5.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "axe-core": "^4.14.1",
    "eslint": "^10.15.0",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-lit-a11y": "^5.1.3",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^17.14.0",
    "lit": "^3.3.3",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.6.8",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "rs-module-lexer@2.9.0": true
  }
}
