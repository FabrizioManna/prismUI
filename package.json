{
  "name": "prismui",
  "version": "1.1.0",
  "description": "**PrismUI** is a modern, framework-agnostic UI component library designed to bring the elegance of **Glassmorphism** to enterprise admin panels and data-rich dashboards.",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "analyze": "cem analyze --litelement --outdir .",
    "scaffold:stories": "node scripts/generate-stories.js",
    "storybook": "npm run analyze && storybook dev -p 6006",
    "build-storybook": "npm run analyze && storybook build",
    "publish:npm": "npm run build && npm publish --access public",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FabrizioManna/prismUI.git"
  },
  "keywords": [
    "ui",
    "components",
    "lit",
    "web-components",
    "glassmorphism",
    "tailwind",
    "prismui"
  ],
  "author": "Fabrizio Manna",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "bugs": {
    "url": "https://github.com/FabrizioManna/prismUI/issues"
  },
  "homepage": "https://github.com/FabrizioManna/prismUI#readme",
  "dependencies": {
    "lit": "^3.3.3",
    "lucide": "^1.35.0",
    "lucide-static": "^1.35.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@storybook/addon-essentials": "^7.0.6",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.18",
    "@storybook/blocks": "^8.6.14",
    "@storybook/web-components-vite": "^8.6.18",
    "@typescript/typescript6": "^6.0.2",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "storybook": "^8.6.18",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3"
  },
  "customElements": "custom-elements.json",
  "overrides": {
    "@babel/traverse": "^7.23.2",
    "esbuild": "^0.25.0"
  }
}
